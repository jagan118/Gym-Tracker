{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "GymLog Client Dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"client",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "GymLog Server Dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"server"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "GymLog Auth Tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--prefix",
				"server",
				"--",
				"--runTestsByPath",
				"__tests__/googleVerify.test.js",
				"__tests__/googleAuth.test.js",
				"__tests__/setPassword.test.js",
				"__tests__/passwordReset.test.js",
				"__tests__/health.test.js",
				"__tests__/workoutValidation.test.js"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GymLog Client Build Check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build",
				"--prefix",
				"client"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "GymLog Client Lint Check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint",
				"--prefix",
				"client"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install password reset mail dependency",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"server"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Update client build dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"client"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install RxJS search dependency",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"client"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}