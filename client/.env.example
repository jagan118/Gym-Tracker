# Environment Variables — Client
# Copy this file to .env and fill in your values

# Set to the backend origin only in production, e.g. https://gymlog-api.onrender.com
# Do not append an API route; /api is added by the client.
# Empty = use the Vite development proxy
VITE_API_URL=

# Google OAuth Client ID (same as server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
